# Copy to .env and fill in. Never commit .env.
#
# SafeZone refuses to start without Supabase credentials. There is deliberately
# no in-memory fallback: MOCK_MODE fakes WhatsApp sends and LLM extraction only.

# ─── Database (required) ────────────────────────────────────────────────────
# Use different Supabase projects for dev and prod; switch by changing the URL.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Safety switches ────────────────────────────────────────────────────────
MOCK_MODE=true
DEMO_MODE=true
ALLOWLIST_ONLY=true
KILL_SWITCH=false

# Comma-separated normalized numbers allowed to receive outbound messages when
# ALLOWLIST_ONLY=true. Example: 923001234567,923009876543
DEMO_ALLOWLIST=

# JSON array of demo volunteers, e.g.
# [{"name":"Ali","phone":"923001234567","zone_ids":["gulshan"],"capabilities":["foot"]}]
DEMO_VOLUNTEERS=[]

# ─── WhatsApp Cloud API ─────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Required for X-Hub-Signature-256 verification. Leave empty only in local dev.
WHATSAPP_APP_SECRET=
# SafeZone's own public number, used to build wa.me join links for the website.
# Digits only, no + and no spaces. THE REPO IS PUBLIC: leave this blank here and
# set it in the deployment environment only.
WHATSAPP_PUBLIC_NUMBER=

# ─── Emergency numbers (a human fills these from an official source) ────────
# Guidance degrades gracefully when these are empty; it never crashes.
EMERGENCY_FIRE=
EMERGENCY_AMBULANCE=
EMERGENCY_POLICE=

# ─── LLM extraction ─────────────────────────────────────────────────────────
# Ordered fallback chain, tried left to right. The first provider with a key
# handles the call; if it fails or rate-limits, the next one does. A provider
# with no key is skipped, not counted as a failure.
# Supported: deepseek | groq | gemini | openai | openrouter
LLM_PROVIDERS=deepseek,groq,gemini

# Per-provider credentials. Models default sensibly per provider when blank.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Single-provider fallback, kept so older .env files keep working. Ignore these
# if you filled in the per-provider keys above.
LLM_PROVIDER=deepseek
LLM_MODEL=
LLM_API_KEY=

# ─── Dispatch and messaging limits ─────────────────────────────────────────
VOLUNTEER_OFFER_RING_SIZE=3
VOLUNTEER_ACCEPT_TIMEOUT_S=300
VOLUNTEER_ARRIVE_TIMEOUT_S=900
# Silence after "Did help reach you?" reopens the case.
PERSON_SILENCE_TIMEOUT_S=900
GLOBAL_MESSAGE_CAP=500
# Used to build absolute responder handoff links. Leave blank for relative.
PUBLIC_BASE_URL=
RESPONDER_LINK_TTL_HOURS=24
PER_NUMBER_RATE_LIMIT=10
PER_NUMBER_RATE_WINDOW_S=300

# ─── Intake behaviour ───────────────────────────────────────────────────────
# Bare greetings ("hi", "salam", "test") never open a case. This only controls
# whether one orientation line is sent back; the filter itself is always on and
# is deterministic, never LLM-gated.
GREETING_REPLY=true

# ─── Website registration ───────────────────────────────────────────────────
# How long a JOIN code stays valid. Short enough that a leaked code is useless,
# long enough to switch apps and type it.
REGISTRATION_CODE_TTL_MINUTES=30

# ─── Area alerts ────────────────────────────────────────────────────────────
# Proactive warnings to registered people. Gated hard on purpose: alert fatigue
# during a disaster is a safety failure, not a UX one.
ZONE_ALERTS_ENABLED=true
# 0.75 is "high" on the risk scale.
ZONE_ALERT_MIN_URGENCY=0.75
# Corroboration is its own kind of severity.
ZONE_ALERT_MIN_REPORTS=3
# One incident must not be able to exhaust GLOBAL_MESSAGE_CAP.
ZONE_ALERT_MAX_RECIPIENTS=50
