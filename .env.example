
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Safety switches ────────────────────────────────────────────────────────
MOCK_MODE=true
DEMO_MODE=true
ALLOWLIST_ONLY=true
KILL_SWITCH=false


SHOW_SIMULATION_LABELS=false


DEMO_ALLOWLIST=

DEMO_VOLUNTEERS=[]


ADMIN_EMAILS=
ADMIN_PASSWORD_HASH=

SESSION_SECRET=
SESSION_TTL_HOURS=12

# ─── WhatsApp Cloud API ─────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Required for X-Hub-Signature-256 verification. Leave empty only in local dev.
WHATSAPP_APP_SECRET=

WHATSAPP_PUBLIC_NUMBER=

# ─── Coordinators ───────────────────────────────────────────────────────────
# Comma-separated numbers alerted when a case opens. Same rule: blank here.
COORDINATOR_NUMBERS=
COORDINATOR_NOTIFY=true

EMERGENCY_FIRE=
EMERGENCY_AMBULANCE=
EMERGENCY_NGO=
# Whether approval also messages the configured number with the handoff link.
OFFICIAL_HANDOFF_AUTOSEND=true


LLM_PROVIDERS=deepseek,groq,gemini

# Per-provider credentials. Models default sensibly per provider when blank.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

#
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# ─── Dispatch and messaging limits ─────────────────────────────────────────
VOLUNTEER_OFFER_RING_SIZE=3
VOLUNTEER_ACCEPT_TIMEOUT_S=300
VOLUNTEER_ARRIVE_TIMEOUT_S=900

VOLUNTEER_MAX_CASES=1

PERSON_SILENCE_TIMEOUT_S=900
GLOBAL_MESSAGE_CAP=500
PER_NUMBER_RATE_LIMIT=10
PER_NUMBER_RATE_WINDOW_S=300
 
PUBLIC_BASE_URL=
RESPONDER_LINK_TTL_HOURS=24

GREETING_REPLY=true


REGISTRATION_CODE_TTL_MINUTES=30

ZONE_ALERTS_ENABLED=true
# 0.75 is "high" on the risk scale.
ZONE_ALERT_MIN_URGENCY=0.75
# Corroboration is its own kind of severity.
ZONE_ALERT_MIN_REPORTS=3
# One incident must not be able to exhaust GLOBAL_MESSAGE_CAP.
ZONE_ALERT_MAX_RECIPIENTS=50
────────────────────────────────────────────────────
LOG_LEVEL=INFO
